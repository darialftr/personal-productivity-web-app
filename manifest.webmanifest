{
  "id": "./",
  "name": "Itera — Productivity made simple",
  "short_name": "Itera",
  "description": "Planifică, studiază și primește remindere inteligente.",
  "lang": "ro",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f7a9b4",
  "theme_color": "#df5b7e",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Astăzi",
      "short_name": "Astăzi",
      "description": "Vezi doar planul și task-urile de astăzi.",
      "url": "./index.html#/today",
      "icons": [
        {
          "src": "itera-icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Adaugă un task",
      "short_name": "Task nou",
      "description": "Deschide direct formularul pentru un task nou.",
      "url": "./index.html?action=add-task#/today",
      "icons": [
        {
          "src": "itera-icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start focus",
      "short_name": "Focus",
      "description": "Pornește sesiunea recomandată de Itera.",
      "url": "./index.html?action=focus#/today",
      "icons": [
        {
          "src": "itera-icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Planifică realist",
      "short_name": "Planifică",
      "description": "Așază task-urile în intervalele libere ale zilei.",
      "url": "./index.html?action=plan#/today",
      "icons": [
        {
          "src": "itera-icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
